// A compiled plugin: code compiled ahead of time (normally by a server) and sent as bytes.
//
// examples/banner.cre is the source. This hex is its compiled form, made with
//     brewster-cli --compile examples/banner.cre
// The bytes are not encryption, but the client never sees the source text, only tokens
// in a binary format, so the code is not easy to read or edit. A server would send the
// hex (or the raw bytes at a url: Plugin::url("https://site/banner.bin")) instead.

h1 "Compiled plugin"
p.id:status "Press a button."
button.onclick:run_compiled "1. Run the compiled plugin once"
button.onclick:shout "2. Call the function it defined"
button.onclick:install_it "3. Install it for the application 'demo'"
button.onclick:bad "4. Try corrupted bytes"

let banner_hex = ""

fn say(text) {
  root.tree.query("#status").unwrap().set_text(text)
}

fn run_compiled(self) {
  match Plugin::compiled(banner_hex) {
    Ok(plugin) => match root.plugin.oneshot(plugin) {
      Ok(_) => say("Ran; its text was added at the end of the page"),
      Err(e) => say("Failed: {e}"),
    },
    Err(e) => say("Not a plugin: {e}"),
  }
}

fn install_it(self) {
  match Plugin::compiled(banner_hex) {
    Ok(plugin) => match root.plugin.install("demo", plugin) {
      Ok(id) => say("Installed {id}; it runs on every page under /demo"),
      Err(e) => say("Could not install: {e}"),
    },
    Err(e) => say("Not a plugin: {e}"),
  }
}

fn bad(self) {
  // Cut the bytes short: the browser refuses them instead of running half a program.
  match Plugin::compiled("4352454201000200") {
    Ok(plugin) => match root.plugin.oneshot(plugin) {
      Ok(_) => say("Unexpectedly ran"),
      Err(e) => say("Refused: {e}"),
    },
    Err(e) => say("Not a plugin: {e}"),
  }
}
