// Applications and plugins.
//
// An application is a service-worker-like scope: an authority (domain or address) plus a
// path. `root.plugin.install("shop", plugin)` on a page of example.com makes the plugin run,
// in the order installed, on every page under example.com/shop. It is saved, so it also
// runs when the page is reloaded without a connection. (To see the banner below, open this
// file from a server at /demo/, e.g. http://localhost:8000/demo/plugins.cre.)
//
// A plugin is written as .cre source here (compiled on this computer). It can also be
// compiled elsewhere (Plugin::compiled("<hex>")) or fetched from a url (Plugin::url("...")).

h1 "Plugins"
p.id:status "Nothing installed yet."
button.onclick:install_banner "Install a banner for the application demo"
button.onclick:list_plugins "List the plugins of the application demo"
button.onclick:run_once "Run a plugin once, here"
button.onclick:remove_all "Remove them again"
link "demo.cre" "Back to the demo"

fn say(text) {
  root.tree.query("#status").unwrap().set_text(text)
}

fn install_banner(self) {
  let banner = Plugin::source("p.fcolor:yellow \"Added by a plugin\"")
  match root.plugin.install("demo", banner) {
    Ok(id) => say("Installed {id}"),
    Err(e) => say("Could not install: {e}"),
  }
}

fn list_plugins(self) {
  match root.plugin.list("demo") {
    Ok(all) => say("{all.len()} plugin(s) installed"),
    Err(e) => say("Could not list: {e}"),
  }
}

fn run_once(self) {
  // Outside an application a plugin runs once, now.
  match root.plugin.oneshot(Plugin::source("let n = root.tree.create(Tag::p).unwrap()\nn.set_text(\"one-shot plugin ran\")\nroot.tree.append(n)")) {
    Ok(_) => say("Ran once"),
    Err(e) => say("Failed: {e}"),
  }
}

fn remove_all(self) {
  match root.plugin.clear("demo") {
    Ok(_) => say("Cleared"),
    Err(e) => say("Could not clear: {e}"),
  }
}
